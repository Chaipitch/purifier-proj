    <description
  >Every morning: reminds customers on LINE when their purifier filter is due in 7 days. Skips assets reminded in the last 30 days.</description>
    <environments>Default</environments>
    <formulas>
        <name>NeedsReminder</name>
        <dataType>Boolean</dataType>
        <expression
    >{!$Record.Next_Filter_Replacement__c} = TODAY() + 1 &amp;&amp; NOT(ISBLANK({!$Record.Account__c})) &amp;&amp; (ISBLANK({!$Record.Last_Filter_Reminder__c}) || {!$Record.Last_Filter_Reminder__c} &lt; TODAY() - 30)</expression>
    </formulas>
