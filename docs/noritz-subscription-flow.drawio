FF;" edge="1" parent="L5" source="L5_ok" target="L5_sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L5" source="L5_dp" target="L5_rt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_rt" target="L5_dr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_dr" target="L5_ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L5" source="L5_dr" target="L5_su"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_su" target="L5_uc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_uc" target="L5_re"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_r" target="L5_rd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e12" value="Renew" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="L5" source="L5_rd" target="L5_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e13" value="Monthly" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_rd" target="L5_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e14" value="End" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="L5" source="L5_rd" target="L5_r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L5" source="L5_r3" target="L5_n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L5_note" value="MOM 11/6: Krungsri's subscription schedule runs the monthly charge; whether Krungsri or Salesforce runs the retries depends on the API. Invoices are issued by staff, not by an automatic monthly run." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;" vertex="1" parent="L5"><mxGeometry x="20" y="706" width="1415" height="26" as="geometry"/></mxCell><mxCell id="L6" value="Step 6 · Filter care and repairs   (≈ 3.5 MD)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="2240" width="1455" height="624" as="geometry"/></mxCell><mxCell id="L6_a" value='&lt;font style="font-size:10px" color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Filter due: LINE reminder with time choices' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_b" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer picks a time' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="225" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_w" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Work order created with the filter-change steps' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="430" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_c" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Partner&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Partner replaces the filter (free)' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DADFE7;strokeColor=#7D8597;dashed=1;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="635" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_d" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff closes the work order; next filter in 6 months' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="840" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_p" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer reports a problem in LINE or by phone' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="20" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_q" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff opens a service case' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="225" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_qd" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fixed over chat?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L6"><mxGeometry x="435.0" y="152.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L6_k" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Case closed' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L6"><mxGeometry x="635" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L6_v" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2E9E&quot;&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&g