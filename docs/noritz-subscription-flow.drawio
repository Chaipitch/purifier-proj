AL &amp;middot; Warehouse&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Unit checked at the warehouse' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L7"><mxGeometry x="635" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L7_wd" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Warehouse&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Can it be reused?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L7"><mxGeometry x="435.0" y="264.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L7_y" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Asset set to Ready for re-use' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L7"><mxGeometry x="225" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L7_n" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Asset set to Terminated' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L7"><mxGeometry x="430" y="386.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L7_lk" value="Step 8: asset status file" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L7"><mxGeometry x="20" y="292.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L7_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L7" source="L7_a" target="L7_d"><mxGeometry relative="1" as="g