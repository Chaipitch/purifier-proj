gonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o5" target="o6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o6" target="o7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="on" value="White = already working in the demo. Orange = to be built. See the next page for every step." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2. Step by step"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NORITZ water purifier subscription: how it works" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="lg1" value="Already working in the demo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="To be built" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="235" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="Done in swifT (accounting system)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DADFE7;strokeColor=#7D8597;" vertex="1" parent="1"><mxGeometry x="450" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lt1" value='&lt;font color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL&lt;/b&gt;&lt;/font&gt;: a person does it (staff, customer, partner)' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="46" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt2" value='&lt;font color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;: happens automatically when something else happens' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="64" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt3" value='&lt;font color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED&lt;/b&gt;&lt;/font&gt;: runs by itself on a date or time' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="82" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt4" value="Diamond = a question with two or more answers" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="400" height="18" as="geometry"/></mxCell><mxCell id="L1" value="Step 1 · Customer joins on LINE" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="1455" height="150" as="geometry"/></mxCell><mxCell id="L1_a" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer adds NORITZ as a LINE friend' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="L1"><mxGeometry x="20" y="52.0" width="170" height="74" as="geometry"/></mxCell>