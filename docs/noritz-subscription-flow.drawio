<mxfile host="app.diagrams.net" type="device"><diagram id="overview" name="1. At a glance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ot" value="NORITZ subscription at a glance" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="36" as="geometry"/></mxCell><mxCell id="o0" value="1. Customer joins on LINE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o1" value="2. Sign-up form" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o2" value="3. First payment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o3" value="4. Installation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o4" value="5. Monthly payment and renewal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="o5" value="6. Filter care and repairs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="190" height="70" as=