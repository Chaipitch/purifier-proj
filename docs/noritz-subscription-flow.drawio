okeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1455" height="260" as="geometry"/></mxCell><mxCell id="L3_a" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff sends a payment link in LINE' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="L3"><mxGeometry x="20" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L3_b" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer pays by card or PromptPay QR' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L3"><mxGeometry x="225" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L3_d" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Payment successful?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L3"><mxGeometry x="435.0" y="39.0" width="160" height="100" as="geometry"/></mxCell><mxCell id="L3_e" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer is asked to try again' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L3"><mxGeometry x="430" y="162.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L3_f" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Prospect becomes a customer with a contract' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="L3"><mxGeom