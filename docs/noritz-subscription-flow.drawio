<mxfile host="app.diagrams.net" type="device"><diagram id="overview" name="1. At a glance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ot" value="NORITZ subscription at a glance" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="36" as="geometry"/></mxCell><mxCell id="o0" value="1. Customer joins on LINE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o1" value="2. Sign-up form inside LINE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o2" value="3. Contract and first payment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o3" value="4. Shipping and installation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="190" height="70" as="geometry"/></mxCell><mxCell id="o4" value="5. Monthly billing, failed payments and renewal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="o5" value="6. Filter care and repairs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="o6" value="7. Cancellation and return" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="o7" value="8. Files for swifT (accounting)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="190" height="70" as="geometry"/></mxCell><mxCell id="oe0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o0" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o5" target="o6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o6" target="o7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="on" value="White = already working in the demo. Orange = to be built. The next page shows every step, marked Manual, Trigger or Scheduled." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1000" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2. Step by step"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NORITZ water purifier subscription: how it works (after MOM 6 Nov)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="lg1" value="Already working in the demo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="1"><mxGeometry x="20" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="To be built" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="1"><mxGeometry x="235" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="Outside Salesforce (partner, swifT)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DADFE7;strokeColor=#7D8597;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="Go to another step" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="665" y="54" width="200" height="30" as="geometry"/></mxCell><mxCell id="lt0" value='&lt;font color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL&lt;/b&gt;&lt;/font&gt;: a person does it (staff, customer, partner)' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="46" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt1" value='&lt;font color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;: happens automatically when something else happens' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="64" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt2" value='&lt;font color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED&lt;/b&gt;&lt;/font&gt;: runs by itself on a date or time' style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="82" width="560" height="18" as="geometry"/></mxCell><mxCell id="lt3" value="Diamond = a question with two or more answers" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="560" height="18" as="geometry"/></mxCell><mxCell id="L1" value="Step 1 · Customer joins on LINE   (Built)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1455" height="288" as="geometry"/></mxCell><mxCell id="L1_a" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer adds NORITZ as a LINE friend' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L1"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L1_d1" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Already a customer or an open prospect?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA3B2;" vertex="1" parent="L1"><mxGeometry x="230.0" y="40.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L1_ex" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Chat linked to the existing record' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L1"><mxGeometry x="225" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L1_cr" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Salesforce creates a new prospect' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L1"><mxGeometry x="430" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L1_ch" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff chats with the customer in Salesforce' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L1"><mxGeometry x="635" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L1_n" value="Step 2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L1"><mxGeometry x="840" y="68.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L1" source="L1_a" target="L1_d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_e1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L1" source="L1_d1" target="L1_ex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_e2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L1" source="L1_d1" target="L1_cr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L1" source="L1_cr" target="L1_ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="L1" source="L1_ex" target="L1_ch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L1" source="L1_ch" target="L1_n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L1_note" value="Already built and tested with a real phone. Duplicates are checked on Lead, not Account (MOM row 10)." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;" vertex="1" parent="L1"><mxGeometry x="20" y="258" width="1415" height="26" as="geometry"/></mxCell><mxCell id="L2" value="Step 2 · Sign-up form inside LINE   (≈ 4.5 MD)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="448" width="1455" height="288" as="geometry"/></mxCell><mxCell id="L2_a" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff sends the sign-up form in LINE' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L2"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L2_b" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer fills in name, address and plan inside LINE' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L2"><mxGeometry x="225" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L2_d" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;All details filled in?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="435.0" y="40.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L2_e" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer is asked to fix the missing details' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L2"><mxGeometry x="430" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L2_f" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Salesforce saves the details on the prospect' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L2"><mxGeometry x="635" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L2_g" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Thank-you message to the customer; staff notified' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L2"><mxGeometry x="840" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L2_n" value="Step 3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L2"><mxGeometry x="1045" y="68.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L2" source="L2_a" target="L2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L2" source="L2_b" target="L2_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L2" source="L2_d" target="L2_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L2" source="L2_d" target="L2_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e4" value="fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="L2" source="L2_e" target="L2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L2" source="L2_f" target="L2_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L2" source="L2_g" target="L2_n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2_note" value="Needs from the client: a LINE Login channel and a LIFF app under the same provider as the LINE OA." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;" vertex="1" parent="L2"><mxGeometry x="20" y="258" width="1415" height="26" as="geometry"/></mxCell><mxCell id="L3" value="Step 3 · Contract and first payment   (≈ 8 MD (Stages 3, 3.1))" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="756" width="1455" height="400" as="geometry"/></mxCell><mxCell id="L3_cv" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff converts the prospect to a customer' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_ct" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff creates the contract' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="225" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_iv" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff sends the contract and first invoice in LINE' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="430" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_da" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer agrees?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L3"><mxGeometry x="640.0" y="40.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L3_fu" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff follows up in the chat' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="635" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_pl" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Payment link sent automatically' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="840" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_py" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer pays by card or PromptPay QR on the Krungsri page' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="1045" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_dp" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Payment successful?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L3"><mxGeometry x="1050.0" y="152.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L3_ag" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer is asked to try again' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="1250" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_ok" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Payment recorded and an order created' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="1045" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_rc" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2E9E&quot;&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;'Payment received' message; card saved for monthly billing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L3"><mxGeometry x="840" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L3_n" value="Step 4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L3"><mxGeometry x="635" y="292.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L3_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_cv" target="L3_ct"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_ct" target="L3_iv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_iv" target="L3_da"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_da" target="L3_pl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L3" source="L3_da" target="L3_fu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="L3" source="L3_fu" target="L3_iv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_pl" target="L3_py"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L3" source="L3_py" target="L3_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_dp" target="L3_ag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="L3" source="L3_ag" target="L3_py"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L3" source="L3_dp" target="L3_ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_ok" target="L3_rc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L3" source="L3_rc" target="L3_n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3_note" value="MOM 11/6: the contract is created by staff and sent as a PDF for sign-off; the invoice is agreed before the payment link goes out. Krungsri API details are still pending." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;" vertex="1" parent="L3"><mxGeometry x="20" y="370" width="1415" height="26" as="geometry"/></mxCell><mxCell id="L4" value="Step 4 · Shipping and installation   (≈ 3 MD + PDFs)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="1176" width="1455" height="288" as="geometry"/></mxCell><mxCell id="L4_wo" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2E9E&quot;&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Work order created with the product's installation steps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_ad" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff sets the date, time and address' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="225" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_tl" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff confirms the date with the customer in the chat' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="225" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_pf" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff prints the shipping label and installation instructions' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="430" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_sd" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff sends the job to the partner by LINE or email' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DADFE7;strokeColor=#7D8597;dashed=1;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="635" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_in" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Partner&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Partner delivers and installs the purifier' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DADFE7;strokeColor=#7D8597;dashed=1;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="840" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_up" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff updates the work order: serial, photos, install date' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="1045" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_st" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff registers the purifier (serial no.) and sets it In Use with the start date' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L4"><mxGeometry x="1250" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L4_n" value="Step 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L4"><mxGeometry x="1250" y="180.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L4_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_wo" target="L4_ad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L4" source="L4_ad" target="L4_tl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_ad" target="L4_pf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_pf" target="L4_sd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_sd" target="L4_in"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_in" target="L4_up"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="L4" source="L4_up" target="L4_st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L4" source="L4_st" target="L4_n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4_note" value="MOM 11/6: no Experience Cloud. Partner communication, installation progress, asset registration and start of use are manual; Salesforce prepares the work order and the documents." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4A5568;" vertex="1" parent="L4"><mxGeometry x="20" y="258" width="1415" height="26" as="geometry"/></mxCell><mxCell id="L5" value="Step 5 · Monthly billing, failed payments and renewal   (≈ 8.5 MD (Stages 5, 5.1, 5.2))" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#E9EDF4;strokeColor=#A3AEC2;swimlaneFillColor=#F6F8FB;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="1484" width="1455" height="736" as="geometry"/></mxCell><mxCell id="L5_iv" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Staff&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Staff issues the monthly invoice' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="20" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_k" value='&lt;font style="font-size:10px" color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED &amp;middot; Krungsri&lt;/b&gt;&lt;/font&gt;&lt;br&gt;On the billing date, Krungsri charges the saved card' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="225" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_rs" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Result recorded in Salesforce' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="430" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_dp" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Paid?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L5"><mxGeometry x="640.0" y="40.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L5_ok" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2E9E&quot;&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;'Payment received' message" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="840" y="50.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_sw" value="Step 8: sales file" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#7D8597;dashed=1;arcSize=50;fontStyle=1;" vertex="1" parent="L5"><mxGeometry x="1045" y="68.0" width="175" height="44" as="geometry"/></mxCell><mxCell id="L5_rt" value='&lt;font style="font-size:10px" color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Retry within the grace period' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="635" y="162.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_dr" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Retry paid?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L5"><mxGeometry x="845.0" y="152.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L5_su" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Service suspended; LINE link to update the card' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="840" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_uc" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer updates the card and pays' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="1045" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_re" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Service reactivated' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA3B2;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="1250" y="274.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_r" value='&lt;font style="font-size:10px" color="#1E7A3C"&gt;&lt;b&gt;&amp;#9200; SCHEDULED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;30 days before the end, LINE asks: renew?' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="20" y="498.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_rd" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F5FAD&quot;&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer's choice" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L5"><mxGeometry x="230.0" y="488.0" width="165" height="100" as="geometry"/></mxCell><mxCell id="L5_r1" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Renew for 12 more months' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="430" y="386.0" width="175" height="80" as="geometry"/></mxCell><mxCell id="L5_r2" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Continue month by month (also if no reply)' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F7A44A;strokeColor=#C4650F;arcSize=12;" vertex="1" parent="L5"><mxGeometry x="430" y="498.0" width="175" height="80" as="geometry"/></mxCell><mxC