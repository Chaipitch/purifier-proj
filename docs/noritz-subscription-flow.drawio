rent="L2"><mxGeometry x="20" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L2_b" value='&lt;font style="font-size:10px" color="#1F5FAD"&gt;&lt;b&gt;&amp;#128100; MANUAL &amp;middot; Customer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer fills in name, address and plan inside LINE' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="225" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L2_d" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;All details filled in?' style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="435.0" y="39.0" width="160" height="100" as="geometry"/></mxCell><mxCell id="L2_e" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer is asked to fix the missing details' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="430" y="162.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L2_f" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Salesforce saves the details' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="635" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id="L2_g" value='&lt;font style="font-size:10px" color="#7A2E9E"&gt;&lt;b&gt;&amp;#9889; TRIGGER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Customer gets a thank-you message' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F7A44A;strokeColor=#C4650F;" vertex="1" parent="L2"><mxGeometry x="840" y="52.0" width="170" height="74" as="geometry"/></mxCell><mxCell id=